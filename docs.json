{
  "$schema": "https://mintlify.com/docs.json",
  "theme": "aspen",
  "name": "Lumeus",
  "description": "Stellar Activity API, Assets API, webhooks and RPC documentation.",
  "colors": {
    "primary": "#9A5410",
    "light": "#F0AE43",
    "dark": "#CE7517"
  },
  "logo": {
    "light": "/logo/light.svg",
    "dark": "/logo/dark.svg"
  },
  "appearance": {
    "default": "system"
  },
  "background": {
    "color": {
      "light": "#FAF8F3",
      "dark": "#14110D"
    }
  },
  "fonts": {
    "family": "Hanken Grotesk",
    "heading": {
      "family": "Hanken Grotesk",
      "weight": 700
    },
    "body": {
      "family": "Hanken Grotesk",
      "weight": 400
    }
  },
  "icons": {
    "library": "lucide"
  },
  "favicon": "/favicon.svg",
  "thumbnails": {
    "appearance": "dark"
  },
  "seo": {
    "metatags": {
      "og:site_name": "Lumeus Docs"
    }
  },
  "styling": {
    "eyebrows": "breadcrumbs",
    "codeblocks": {
      "theme": {
        "light": "github-light",
        "dark": "github-dark"
      }
    }
  },
  "api": {
    "playground": {
      "display": "interactive",
      "proxy": false
    },
    "examples": {
      "languages": [
        "curl",
        "javascript",
        "python"
      ],
      "defaults": "required",
      "prefill": true
    }
  },
  "contextual": {
    "options": [
      "copy",
      "view",
      "chatgpt",
      "claude"
    ]
  },
  "navigation": {
    "tabs": [
      {
        "tab": "Documentation",
        "icon": "book-open",
